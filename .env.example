# AI (photo analysis + weekly notes). Set ONE of these in Vercel → Settings → Environment Variables.
OPENROUTER_API_KEY=
# Optional: OpenRouter model id (falls back to google/gemini-2.5-flash, openai/gpt-4o-mini, anthropic/claude-sonnet-4.5)
AI_MODEL=
# Or Claude directly:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Supabase (optional; without it data is saved in the browser only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
